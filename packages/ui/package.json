{
  "name": "@forge/ui",
  "version": "0.1.0",
  "description": "Forge design system core SolidJS components (shell, forms, overlays, feedback, data).",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "styles"],
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./styles/console.css"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/tokens": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "happy-dom": "^20.11.1",
    "solid-js": "^1.9.0",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
