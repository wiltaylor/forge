{
  "name": "@forge/tauri",
  "version": "0.1.0",
  "description": "Forge client over Tauri IPC: the @forge/client interface with no HTTP server, plus widget transports.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/client": "workspace:^",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
