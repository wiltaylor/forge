{
  "name": "@forge/remote",
  "version": "0.1.0",
  "description": "Forge component federation: export SolidJS components as web-component bundles and mount remote ones (JWT-authenticated).",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "solid": "./dist/index/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index/index.js"
      }
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/no-tests-yet.mjs"
  },
  "dependencies": {
    "@forge/ui": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "solid-js": "^1.9.0",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.5"
  }
}
