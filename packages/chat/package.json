{
  "name": "@forge/chat",
  "version": "0.1.0",
  "description": "Forge design system chat UI — conversation view, tool-call cards, interactive prompts, link cards, markdown, composer for SolidJS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./styles/chat.css"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepare": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/ui": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "happy-dom": "^20.11.1",
    "solid-js": "^1.9.0",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
