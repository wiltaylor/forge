{
  "name": "@forge/term",
  "version": "0.1.0",
  "description": "Forge design system xterm.js terminal widget for SolidJS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "styles"],
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./styles/term.css"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepare": "node ../../scripts/prepare-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/no-tests-yet.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^7.0.0"
  }
}
