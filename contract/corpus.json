{
  "contract_version": "1.0",
  "transports": ["rust-http", "python-http", "rust-ipc", "ts-client"],
  "vars": {
    "app": "forge-contract-corpus",
    "user": "admin",
    "password": "hunter2",
    "wrong_password": "definitely-wrong",
    "hashed_user": "overseer",
    "hashed_password": "s3cret",
    "hashed_secret": "$argon2id$v=19$m=19456,t=2,p=1$oIonqyWQKyCxWwPHZhDWFQ$MatG+SWES3ScVBSWxHLZ6y0BwSH/jxcJYuHBHO3gME4",
    "issuer": "forge",
    "doc": "paritytest-doc",
    "bad_doc": "UPPER",
    "component_file": "widget.js",
    "sse_topic": "paritytest-sse",
    "ws_topic": "paritytest-ws",
    "ws_quiet_topic": "paritytest-ws-quiet",
    "ws_flood_topic": "paritytest-ws-flood"
  },
  "fixtures": {
    "default": {
      "app": "${app}",
      "auth": {
        "enabled": true,
        "users": [
          { "name": "${user}", "password": "${password}", "roles": [] },
          {
            "name": "${hashed_user}",
            "password": "${hashed_password}",
            "secret": "${hashed_secret}",
            "roles": []
          }
        ]
      },
      "docstore": true,
      "events": {},
      "actions": ["echo", "publish"],
      "components": {
        "manifest": {
          "components": [
            {
              "name": "Widget",
              "tag": "forge-widget",
              "file": "${component_file}",
              "hash": "sha256-corpus",
              "props": [],
              "events": [],
              "version": "1.0.0"
            }
          ]
        },
        "files": {
          "${component_file}": "export const widget = 1;\n"
        }
      },
      "frontend": {
        "files": {
          "index.html": "<!doctype html>\n<title>corpus</title>\n"
        }
      }
    },
    "auth-disabled": {
      "app": "${app}",
      "auth": { "enabled": false },
      "docstore": true,
      "events": {},
      "actions": ["echo"],
      "components": {
        "manifest": {
          "components": [
            {
              "name": "Widget",
              "tag": "forge-widget",
              "file": "${component_file}",
              "hash": "sha256-corpus",
              "props": [],
              "events": [],
              "version": "1.0.0"
            }
          ]
        },
        "files": {
          "${component_file}": "export const widget = 1;\n"
        }
      }
    },
    "absent-manifest": {
      "app": "${app}",
      "auth": {
        "enabled": true,
        "users": [{ "name": "${user}", "password": "${password}", "roles": [] }]
      },
      "components": {
        "files": {
          "${component_file}": "export const widget = 1;\n"
        }
      }
    },
    "events-tuned": {
      "app": "${app}",
      "auth": {
        "enabled": true,
        "users": [{ "name": "${user}", "password": "${password}", "roles": [] }]
      },
      "events": { "buffer": 1, "heartbeat_s": 1 },
      "actions": ["flood"]
    }
  },
  "cases": [
    {
      "id": "health-open",
      "title": "GET /api/health needs no token and reports capabilities",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/health", "auth": "none" },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "auth_enabled": true,
                "uptime_s": { "$type": "number" },
                "actions": ["echo", "publish"]
              }
            }
          }
        }
      ]
    },
    {
      "id": "login-returns-token",
      "title": "POST /api/auth/login returns a token, an expiry and the user",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/auth/login",
            "auth": "none",
            "body": { "username": "${user}", "password": "${password}" }
          },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "token": { "$min_length": 1 },
                "expires_at": { "$type": "number" },
                "user": { "name": "${user}", "roles": { "$exact": [] } }
              }
            }
          }
        }
      ]
    },
    {
      "id": "login-bad-credentials",
      "title": "POST /api/auth/login rejects a wrong password with 401",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/auth/login",
            "auth": "none",
            "body": { "username": "${user}", "password": "${wrong_password}" }
          },
          "expect": {
            "status": 401,
            "body": { "ok": false, "error": { "$type": "string" } }
          }
        }
      ]
    },
    {
      "id": "login-with-a-hashed-credential",
      "title": "A user whose stored secret is an argon2 hash logs in, and only with the right password",
      "note": "The shipped-defect case. `${hashed_secret}` is real forge-hash output, and an argon2 PHC hash carries commas in its parameters (`m=19456,t=2,p=1`) — the separator the FORGE_AUTH_USERS format also uses. A backend that splits that variable naively boots with a mangled secret and answers this case with a 401.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/auth/login",
            "auth": "none",
            "body": {
              "username": "${hashed_user}",
              "password": "${hashed_password}"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "token": { "$min_length": 1 },
                "user": { "name": "${hashed_user}" }
              }
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/auth/login",
            "auth": "none",
            "body": {
              "username": "${hashed_user}",
              "password": "${wrong_password}"
            }
          },
          "expect": { "status": 401, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "me-requires-token",
      "title": "GET /api/auth/me without a token is 401",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/auth/me", "auth": "none" },
          "expect": { "status": 401, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "me-with-bearer",
      "title": "GET /api/auth/me returns the decoded claims for a bearer token",
      "note": "The whole payload, not a subset: the contract names four members for this endpoint, and a backend that adds a fifth is shipping a claim the contract does not describe. `iss` is the contract's default issuer, which neither driver configures.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/auth/me", "auth": "bearer" },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "$exact": {
                  "sub": "${user}",
                  "roles": [],
                  "iss": "${issuer}",
                  "exp": { "$type": "integer" }
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "me-with-query-token",
      "title": "A ?token= query parameter is accepted in place of the header",
      "applies": ["rust-http", "python-http", "ts-client"],
      "inapplicable": {
        "rust-ipc": "IPC commands take typed arguments; there is no query string to carry a token."
      },
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/auth/me", "auth": "query" },
          "expect": { "status": 200, "body": { "data": { "sub": "${user}" } } }
        }
      ]
    },
    {
      "id": "me-garbage-token-rejected",
      "title": "A token that is not a JWT is rejected with 401",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/api/auth/me",
            "auth": "none",
            "headers": { "authorization": "Bearer not.a.jwt" }
          },
          "expect": { "status": 401, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "data-requires-auth",
      "title": "GET /api/data without a token is 401",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/data", "auth": "none" },
          "expect": { "status": 401, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-roundtrip",
      "title": "A document can be written, read, listed, deleted twice and is then gone",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/${doc}",
            "auth": "bearer",
            "body": { "n": 1, "nested": { "ok": true }, "s": "x" }
          },
          "expect": { "status": 200, "body": { "ok": true } }
        },
        {
          "request": { "method": "GET", "path": "/api/data/${doc}", "auth": "bearer" },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": { "$exact": { "n": 1, "nested": { "ok": true }, "s": "x" } }
            }
          }
        },
        {
          "request": { "method": "GET", "path": "/api/data", "auth": "bearer" },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "$contains": {
                  "name": "${doc}",
                  "bytes": { "$gt": 0 },
                  "modified": { "$type": "number" }
                }
              }
            }
          }
        },
        {
          "request": { "method": "DELETE", "path": "/api/data/${doc}", "auth": "bearer" },
          "expect": { "status": 200, "body": { "ok": true } }
        },
        {
          "request": { "method": "DELETE", "path": "/api/data/${doc}", "auth": "bearer" },
          "expect": { "status": 200, "body": { "ok": true } }
        },
        {
          "request": { "method": "GET", "path": "/api/data/${doc}", "auth": "bearer" },
          "expect": {
            "status": 404,
            "body": { "ok": false, "error": { "$type": "string" } }
          }
        }
      ]
    },
    {
      "id": "doc-name-rejected-uppercase",
      "title": "A document name with an upper-case letter is rejected with 400",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/${bad_doc}",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-on-read",
      "title": "A read of an invalid document name is 400, not 404",
      "note": "The name rule guards every verb, not only the one that writes. A backend that checks it on the way in and not on the way out answers 404 here, which says the document is missing rather than that the name is not one.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/data/${bad_doc}", "auth": "bearer" },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-on-delete",
      "title": "A delete of an invalid document name is 400, not an idempotent success",
      "note": "Delete is idempotent for a name that is valid and absent. An invalid name is a different answer: the rule is the path-traversal guard, so it cannot be skipped on the verb that removes files.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "DELETE", "path": "/api/data/${bad_doc}", "auth": "bearer" },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-leading-dash",
      "title": "A document name starting with a dash is rejected with 400",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/-lead",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-leading-dot",
      "title": "A document name starting with a dot is rejected with 400",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/.dot",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-accepted-at-the-length-limit",
      "title": "A document name of exactly 64 characters is accepted",
      "note": "The boundary, from the inside. `^[a-z0-9][a-z0-9_-]{0,63}$` admits 64 characters, so an implementation that counts one out is caught here rather than by a name so long that every off-by-one still rejects it.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "auth": "bearer",
            "body": { "at": "the-limit" }
          },
          "expect": { "status": 200, "body": { "ok": true } }
        },
        {
          "request": {
            "method": "DELETE",
            "path": "/api/data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "auth": "bearer"
          },
          "expect": { "status": 200, "body": { "ok": true } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-too-long",
      "title": "A document name of 65 characters is rejected with 400",
      "note": "One character past the limit, so the case sits against `doc-name-accepted-at-the-length-limit` rather than well clear of it.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-space",
      "title": "A document name containing a space is rejected with 400",
      "note": "Authored percent-encoded because that is what a space looks like on the wire.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/a%20b",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-dot-dot",
      "title": "A document name of two dots is rejected with 400",
      "note": "Percent-encoded so the dot segment reaches the doc-name rule instead of being collapsed by a URL normaliser.",
      "applies": ["rust-http", "python-http", "rust-ipc"],
      "inapplicable": {
        "ts-client": "Every fetch resolves its target through the WHATWG URL parser, which reads %2E%2E as a dot segment and collapses it away before the wire, so the client cannot send this path."
      },
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/%2E%2E",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 400, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "doc-name-rejected-path-separator",
      "title": "A document name containing a slash never reaches the route and is 404",
      "note": "The doc-name rule is not what rejects this one: a second path segment misses the route. Equally safe, and every transport that routes on a path must agree on it.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/data/sl/ash",
            "auth": "bearer",
            "body": {}
          },
          "expect": { "status": 404, "body": { "ok": false } }
        }
      ]
    },
    {
      "id": "action-echo",
      "title": "POST /api/actions/echo returns the payload it was given",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/actions/echo",
            "auth": "bearer",
            "body": { "ping": "pong", "n": 3 }
          },
          "expect": {
            "status": 200,
            "body": { "ok": true, "data": { "$exact": { "ping": "pong", "n": 3 } } }
          }
        }
      ]
    },
    {
      "id": "action-unknown",
      "title": "An unregistered action is 404 and the error lists the registered names",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/actions/definitely-not-registered",
            "auth": "bearer",
            "body": {}
          },
          "expect": {
            "status": 404,
            "body": { "ok": false, "error": { "$contains": "echo" } }
          }
        }
      ]
    },
    {
      "id": "sse-delivers-published-event",
      "title": "An event published while an SSE stream is open arrives on that stream",
      "kind": "sse",
      "applies": ["rust-http", "python-http"],
      "inapplicable": {
        "rust-ipc": "IPC delivers events as Tauri events, not as an HTTP event stream.",
        "ts-client": "EventSource exposes neither the response status nor the content-type header this case asserts."
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/api/events",
            "auth": "query",
            "query": { "topics": "${sse_topic}" }
          },
          "expect": {
            "status": 200,
            "headers": { "content-type": { "$prefix": "text/event-stream" } }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/actions/publish",
            "auth": "bearer",
            "body": { "topic": "${sse_topic}", "data": { "hello": "sse" } }
          },
          "expect": { "status": 200, "body": { "ok": true } }
        },
        {
          "await_event": {
            "topic": "${sse_topic}",
            "data": { "$exact": { "hello": "sse" } }
          }
        }
      ]
    },
    {
      "id": "sse-heartbeat-holds-an-idle-stream-open",
      "title": "An idle event stream carries a heartbeat comment",
      "kind": "sse",
      "fixture": "events-tuned",
      "note": "The contract sends the heartbeat every 15 s; this fixture asks for one a second, because the case is about the comment arriving, not about the interval. Nothing publishes here, so the heartbeat is the only thing the stream can carry.",
      "applies": ["rust-http", "python-http"],
      "inapplicable": {
        "rust-ipc": "IPC delivers events as Tauri events; there is no event stream, so nothing holds one open.",
        "ts-client": "EventSource drops comment lines before the client sees them, so a heartbeat cannot be observed through it."
      },
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/events", "auth": "query" },
          "expect": {
            "status": 200,
            "headers": { "content-type": { "$prefix": "text/event-stream" } }
          }
        },
        { "await_heartbeat": "ping" }
      ]
    },
    {
      "id": "api-miss-is-json-404",
      "title": "An unknown /api path is a JSON 404 envelope, not the SPA fallback",
      "applies": ["rust-http", "python-http", "ts-client"],
      "inapplicable": {
        "rust-ipc": "An IPC response carries a status and an envelope, with no room for the content-type header this case is about."
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/api/definitely-not-a-route",
            "auth": "none"
          },
          "expect": {
            "status": 404,
            "headers": { "content-type": { "$prefix": "application/json" } },
            "body": { "ok": false }
          }
        }
      ]
    },
    {
      "id": "spa-fallback-serves-html",
      "title": "An unknown non-/api path falls back to the SPA index",
      "applies": ["rust-http", "python-http"],
      "inapplicable": {
        "rust-ipc": "The webview loads its assets directly; the bridge serves no static frontend.",
        "ts-client": "The client parses envelopes; an HTML response is outside its surface."
      },
      "steps": [
        {
          "request": { "method": "GET", "path": "/some/client/route", "auth": "none" },
          "expect": {
            "status": 200,
            "headers": { "content-type": { "$contains": "text/html" } },
            "text": { "$contains": "<!doctype html>" }
          }
        }
      ]
    },
    {
      "id": "components-manifest",
      "title": "GET /api/components returns the manifest with the app name injected",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/components", "auth": "bearer" },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "app": "${app}",
                "components": [
                  { "name": "Widget", "tag": "forge-widget", "file": "${component_file}" }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "components-absent-manifest-is-an-empty-catalogue",
      "title": "A components directory with no manifest.json is an empty catalogue",
      "fixture": "absent-manifest",
      "note": "This is where the two HTTP backends used to disagree — one a 404, the other an empty list — and where the suite that guarded them skipped itself. The contract states one response shape for this endpoint and names no error status for it, unlike the endpoints where a miss is a 404 (`/api/data/{name}`, `/api/actions/{name}`), so an absent manifest is a catalogue with nothing in it.",
      "applies": ["rust-http", "python-http", "rust-ipc", "ts-client"],
      "inapplicable": {},
      "steps": [
        {
          "request": { "method": "GET", "path": "/api/components", "auth": "bearer" },
          "expect": {
            "status": 200,
            "body": {
              "ok": true,
              "data": { "$exact": { "app": "${app}", "components": [] } }
            }
          }
        }
      ]
    },
