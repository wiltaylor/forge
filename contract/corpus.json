        { "send": { "type": "ping" } },
        { "await_frame": { "$exact": { "type": "pong" } } },
        {
          "request": {
            "method": "POST",
            "path": "/api/actions/flood",
            "auth": "bearer",
            "body": { "topic": "${ws_flood_topic}", "count": 64 }
          },
          "expect": { "status": 200, "body": { "ok": true } }
        },
        { "await_frame": { "$exact": { "type": "lagged" } } }
      ]
