    {
      "id": "shortcut-dash-space-converts-before-a-todo-prefix-completes",
      "title": "Typing \"- [ ] \" makes a bullet item holding \"[ ] \", because \"- \" converts first",
      "note": "The grammar reads the todo prefixes before the bullet one, but a shortcut fires the moment its prefix is complete, and \"- \" completes first. \"[] \" is the typed route to a todo; \"- [ ] \" is the pasted one.",
      "applies": ["rust-tui", "rust-egui", "web"],
      "doc": [{ "type": "paragraph", "md": "" }],
      "at": { "block": 0, "caret": 0 },
      "keys": [
        { "code": "Minus", "key": "-" },
        { "code": "Space", "key": " " },
        { "code": "BracketLeft", "key": "[" },
        { "code": "Space", "key": " " },
        { "code": "BracketRight", "key": "]" },
        { "code": "Space", "key": " " }
      ],
      "expect": [
        { "type": "list_item", "style": "bullet", "indent": 0, "md": "[ ] " }
      ]
    },
    {
      "id": "shortcut-empty-brackets-makes-an-unchecked-todo",
      "title": "Typing \"[] \" at the start of a paragraph makes an unchecked todo",
      "applies": ["rust-tui", "rust-egui", "web"],
      "doc": [{ "type": "paragraph", "md": "" }],
      "at": { "block": 0, "caret": 0 },
      "keys": [
        { "code": "BracketLeft", "key": "[" },
        { "code": "BracketRight", "key": "]" },
        { "code": "Space", "key": " " }
      ],
      "expect": [
        { "type": "list_item", "style": "todo", "checked": false, "indent": 0, "md": "" }
      ]
    },
    {
      "id": "shortcut-angle-space-makes-a-quote",
      "title": "Typing \"> \" at the start of a paragraph makes a quote",
      "applies": ["rust-tui", "rust-egui", "web"],
      "doc": [{ "type": "paragraph", "md": "" }],
      "at": { "block": 0, "caret": 0 },
      "keys": [
        { "code": "Period", "key": ">", "shift": true },
        { "code": "Space", "key": " " }
      ],
      "expect": [{ "type": "quote", "md": "" }]
    },
    {
      "id": "shortcut-three-backticks-makes-a-code-block",
      "title": "Typing \"```\" at the start of a paragraph makes a code block",
      "note": "The grammar accepts an empty language, so the third backtick converts. A language typed after it lands in the code body, not in `lang`.",
      "applies": ["rust-tui", "rust-egui", "web"],
      "doc": [{ "type": "paragraph", "md": "" }],
      "at": { "block": 0, "caret": 0 },
      "keys": [
        { "code": "Backquote", "key": "`" },
        { "code": "Backquote", "key": "`" },
