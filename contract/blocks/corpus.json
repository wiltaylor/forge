    {
      "id": "shortcut-one-paren-space-makes-a-numbered-item",
      "title": "Typing \"1) \" at the start of a paragraph makes a numbered item",
      "applies": ["rust-tui", "rust-egui", "web"],
      "doc": [{ "type": "paragraph", "md": "" }],
      "at": { "block": 0, "caret": 0 },
      "keys": [
        { "code": "Digit1", "key": "1" },
        { "code": "Digit0", "key": ")", "shift": true },
        { "code": "Space", "key": " " }
